# Copy to `.env` in this directory and fill in your values.
# `.env` is gitignored — never commit secrets.
#
# Used by:
#   - apps/api  (Brooklyn OpenAI proxy for codingChallengeList)
#   - apps/web  (Gaia stage GraphQL for contentList)

# JWT for Gaia stage GraphQL (web). Raw token or full "Bearer <token>" header value.
GRAPHQL_AUTH=

# Brooklyn OpenAI proxy (api). Raw token or full "Bearer <token>" — both work.
BROOKLYN_URL=https://brooklyn-stage-f7ydas.gaia.com
BROOKLYN_BEARER_TOKEN=

# Optional overrides (defaults come from apps/web/config/*.yml)
# GAIA_GRAPHQL_URI=https://graphql-stage.gaia.com/graphql
# CODING_CHALLENGE_GRAPHQL_URI=http://localhost:9001/graphql
# GRAPHQL_PROXY_TARGET=https://graphql-stage.gaia.com
